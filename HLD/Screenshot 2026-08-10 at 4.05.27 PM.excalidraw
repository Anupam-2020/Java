    {
      "id": "vvmiFyhlP8Cy5Rbl4drKX",
      "type": "text",
      "x": 417.828125,
      "y": 545.26953125,
      "width": 585.7593383789062,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aE",
      "roundness": null,
      "seed": 1933607377,
      "version": 541,
      "versionNonce": 789569009,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1786982120133,
      "link": null,
      "locked": false,
      "text": "Bit.ly is a URL shortner service that lets you shorten and customize links.\n\nFunctional Requirements:\n- Create a short url from long url\n    - optional: support custom url\n    - optional: support expiration date\n- User should redirected to the original url from short url\n\nNon-functional requirements:\n    - low latency. (url-creating, on redirect ~200ms)\n    - Scale: 100million DAU / 1B url\n    - shorten url should be unique.\n    - CAP: Availability >> constistency (eventual)",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Bit.ly is a URL shortner service that lets you shorten and customize links.\n\nFunctional Requirements:\n- Create a short url from long url\n    - optional: support custom url\n    - optional: support expiration date\n- User should redirected to the original url from short url\n\nNon-functional requirements:\n    - low latency. (url-creating, on redirect ~200ms)\n    - Scale: 100million DAU / 1B url\n    - shorten url should be unique.\n    - CAP: Availability >> constistency (eventual)",
      "autoResize": true,
      "lineHeight": 1.25
    },
